APP_NAME="AI Examination Studio"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
ALLOWED_ORIGINS=["http://localhost:4200"]
MATERIAL_STORAGE_PATH=storage/materials
MAX_UPLOAD_BYTES=20971520

MONGODB_URL="mongodb://localhost:27017/"
MONGODB_DATABASE="ai_examination_studio"
JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
LLM_PROVIDER=deterministic
# Optional: use a different provider-model identifier for critic and solver calls.
LLM_CRITIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=60
# Use the HTTPS ngrok URL printed by the running Kaggle notebook.
# The tunnel must forward to Ollama's port 11434. Keep it secret if the tunnel
# is protected; Ollama itself does not provide API-key authentication by default.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_TIMEOUT_SECONDS=300
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME="AI Examination Studio"
OPENROUTER_TIMEOUT_SECONDS=60
# Optional ordered rate-limit failover keys. The next key is used only after
# HTTP 429; NVIDIA_API_KEY is used after all configured OpenRouter keys.
OPENROUTER2_API_KEY=
OPENROUTER2_MODEL=
OPENROUTER2_APP_NAME=
OPENROUTER2_TIMEOUT_SECONDS=
OPENROUTER3_API_KEY=
OPENROUTER3_MODEL=
OPENROUTER3_APP_NAME=
OPENROUTER3_TIMEOUT_SECONDS=

# Optional web search used only when open-domain mode has no indexed matches.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Optional semantic retrieval. Leave both URL and key empty for local lexical retrieval.
# Configure a compatible embeddings API base URL (without the /embeddings suffix)
# and an API key. Material chunks and queries are sent to this provider.
RETRIEVAL_EMBEDDING_API_BASE_URL=
RETRIEVAL_EMBEDDING_API_KEY=
RETRIEVAL_EMBEDDING_MODEL=
# Set to the model's exact output vector size; the Atlas index must use this value.
RETRIEVAL_EMBEDDING_DIMENSIONS=
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=30
RETRIEVAL_VECTOR_INDEX_NAME=document_chunks_vector_v1
